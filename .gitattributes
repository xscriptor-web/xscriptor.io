# Normalización de fin de línea y detección de binarios
* text=auto

# --- Texto: LF ---
*.ts  text eol=lf
*.tsx text eol=lf
*.js  text eol=lf
*.mjs text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md  text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.txt text eol=lf
*.svg text eol=lf
*.asc text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.htaccess text eol=lf
/public/_headers text eol=lf

# Lockfiles
package-lock.json text eol=lf
pnpm-lock.yaml text eol=lf

# --- Binarios ---
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.bmp  binary
*.mp4  binary
*.webm binary
*.mov  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.eot  binary
*.pdf  binary
*.zip  binary
*.gz   binary

# Generado por scripts/ascii-video.mjs (se oculta de diffs/estadísticas)
public/ascii/homevideo.json linguist-generated=true
